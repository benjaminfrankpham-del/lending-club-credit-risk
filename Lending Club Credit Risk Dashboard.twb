            <column caption='Profit Per 100 Applicants' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[profit_per_100_applicants]' role='measure' type='quantitative' />
            <column-instance column='[profit_per_100_applicants]' derivation='Sum' name='[sum:profit_per_100_applicants:qk]' pivot='key' type='quantitative' />
            <column caption='Approval cutoff' datatype='string' name='[threshold]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <alphabetic-sort column='[federated.0d3mw820z3702q1fjjiz01froyio].[none:threshold:nk]' direction='ASC' />
