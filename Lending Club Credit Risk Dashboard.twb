    <worksheet name='Profit Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Arial' fontsize='14'>Expected profit per applicant (% of loan amount)</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Illustrative assumptions: 15% profit on repaid loans, 60% loss on defaulted loans. A real lender would use its own margins and loss rates.</run>
          </formatted-text>
