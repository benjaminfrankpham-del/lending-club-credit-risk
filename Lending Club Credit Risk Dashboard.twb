                <zone forceUpdate='true' h='7699' id='3' type-v2='text' w='98858' x='571' y='800'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='20'>Lending Club Credit Risk: Which Borrowers Default, and Where Should a Lender Draw the Line?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
