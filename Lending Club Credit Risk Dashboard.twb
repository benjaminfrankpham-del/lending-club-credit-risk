              <calculation class='tableau' formula='IF [threshold] = &quot;0.2&quot; THEN &quot;Recommended cutoff&quot;&#10;ELSEIF [threshold] = &quot;Approve all&quot; THEN &quot;Approve everyone&quot;&#10;ELSE &quot;Other cutoffs&quot;&#10;END' />
            </column>
