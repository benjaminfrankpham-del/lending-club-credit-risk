                      <formatted-text>
                        <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>0.70</run>
                        <run fontcolor='#000000' fontname='Arial' fontsize='16'> AUC (applicant-only logistic regression, </run>
                        <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>146,657</run>
                        <run fontcolor='#000000' fontname='Arial' fontsize='16'> held-out loans)</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
