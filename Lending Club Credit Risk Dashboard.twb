                <zone h='6400' id='33' name='Threshold tradeoff' pane-specification-id='2' param='[federated.0d3mw820z3702q1fjjiz01froyio].[:Measure Names]' show-title='false' type-v2='color' w='14929' x='6714' y='49700'>
