                </zone>
                <zone forceUpdate='true' h='7500' id='5' type-v2='text' w='32714' x='571' y='8499'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='16'>18.8%</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Arial' fontsize='16'> of loans defaulted overall</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7500' id='7' type-v2='text' w='33354' x='33285' y='8499'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>0.20</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='16'> recommended cutoff: approves </run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'>65%</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='16'> of applicants at a</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='16'> 12% </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='16'>default rate</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
